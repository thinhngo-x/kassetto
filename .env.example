# Kassetto settings. Copy to .env and edit. Every setting is optional unless marked.
# (Installs from before the rename: the old YTM_* names are still read; see docs/upgrading-from-ytm.md.)

# --- containers -------------------------------------------------------------------------------------------
PUID=1000                        # the containers run as this user / group: the owner of ./data and ./models
PGID=1000
TZ=UTC                           # your time zone (weekly lists, Daily Mixes, time-of-day taste)
# KASSETTO_VERSION=latest        # image tag
# KASSETTO_BIND=0.0.0.0          # address the ports listen on (e.g. your LAN address)

# --- who is listening (docs/sign-in.md) -------------------------------------------------------------------
KASSETTO_OWNER=admin             # the owner's user name (manages people and the speaker)
KASSETTO_AUTH=none               # none: one person, no sign-in | proxy: behind a sign-in proxy
# KASSETTO_TRUSTED_PROXIES=172.18.0.0/16   # required with proxy: the proxy's address / network
# KASSETTO_AUTH_HEADER=Remote-User
# KASSETTO_AUTH_NAME_HEADER=Remote-Name

# --- catalogue --------------------------------------------------------------------------------------------
# KASSETTO_LANGUAGE=en           # YouTube Music's language for titles / shelves
# KASSETTO_LOCATION=             # country code for the catalogue and home feed (empty: YouTube Music's default)
# KASSETTO_REGION=               # extra regional content, e.g. VN (charts, local-language shelves); off when empty
# KASSETTO_REGION_NAME=          # display name for a region Kassetto doesn't know

# --- audio ------------------------------------------------------------------------------------------------
# KASSETTO_CACHE_MB=3000         # audio cache size on disk
# KASSETTO_TARGET_LUFS=-14       # loudness levelling target (with the embed service)
# KASSETTO_YTDLP_UPDATE=1        # fetch the newest yt-dlp at start (into data/.yt-dlp) when YouTube breaks the built-in one

# --- Cast speaker (docs/cast.md) --------------------------------------------------------------------------
# KASSETTO_SPEAKER=192.168.1.50  # a fixed speaker address (else pick one in Settings; needs network_mode: host)
# KASSETTO_SPEAKER_NAME=Kitchen
# KASSETTO_STREAM_BASE=http://192.168.1.10:8091   # how the speaker reaches this server's port 8091 (not needed with network_mode: host)

# --- ListenBrainz (optional) ------------------------------------------------------------------------------
# The owner's account: listens from other players, collaborative filtering, scrobbling.
# LISTENBRAINZ_USER=
# LISTENBRAINZ_USER_TOKEN=

# --- embed service (optional, --profile embed) ------------------------------------------------------------
# EMBED_THREADS=2
# IDLE_UNLOAD=600                # free the model after this many idle seconds
# KASSETTO_EMBED_URL=http://kassetto-embed:8099
